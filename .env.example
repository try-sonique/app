# Supabase (Auth + profiles) — optionnel
# Sans ces clés, l'app fonctionne en local (profils dans le navigateur).
# Create a project at https://supabase.com → Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Then in Supabase SQL Editor, run: supabase/profiles.sql
# Auth → Providers → Email: enable Email
# For smoother demo: Auth → Providers → Email → disable "Confirm email"
# Site URL / Redirect URLs: add https://try-sonique.github.io/app/
